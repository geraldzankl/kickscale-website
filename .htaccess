# Permanent domain redirect for Hostinger Apache / LiteSpeed.
# Only kickscale.si and www.kickscale.si are redirected.
# resources.kickscale.si must remain independent.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?kickscale\.si$ [NC]
  RewriteRule ^ https://kickscale.com/ [R=301,L,QSD]
</IfModule>
