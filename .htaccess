# Kickscale enterprise website - Hostinger Apache/LiteSpeed PHP 8.1+
Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# www -> canonical apex, preserving paths
RewriteCond %{HTTP_HOST} ^www\.kickscale\.si$ [NC]
RewriteRule ^ https://kickscale.si%{REQUEST_URI} [R=301,L]
# Strictly serve existing static assets and the verification files
RewriteRule ^(site\.css|site\.js|robots\.txt|sitemap\.xml|favicon\.ico)$ - [L]
RewriteRule ^assets/ - [L]
# Send all public routes to the PHP front controller; it returns 404 for unknown URLs
RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Kickscale-Edition "enterprise-site-v1"
</IfModule>